{
  "core": {
    "workingDir": ".reg",
    "actualDir": "${VRT_SCREENSHOTS_DIR}",
    "matchingThreshold": 0.01,
    "enableAntialias": true,
    "thresholdPixel": 10
  },
  "plugins": {
    "reg-simple-keygen-plugin": {
      "expectedKey": "${VRT_EXPECTED_KEY}",
      "actualKey": "${VRT_ACTUAL_KEY}"
    }
  }
}
